// Recursos de «Pasar a Quantum.exe»: ícono, manifiesto y datos del archivo
#include <winver.h>
1 ICON "app.ico"
1 24 "instalar.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0C0A04B0"
    BEGIN
      VALUE "CompanyName", "Quantum Linux"
      VALUE "FileDescription", "Instalar Quantum Linux desde Windows"
      VALUE "FileVersion", "1.0.0"
      VALUE "ProductName", "Instalar Quantum Linux"
      VALUE "ProductVersion", "1.0.0"
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "Instalar Quantum.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0C0A, 1200
  END
END
