// Quantum Linux: «Pasar desde Windows» puede cambiar la zona horaria, la foto y el nombre de la
// propia cuenta y guardar redes Wi-Fi sin pedir contraseña (solo el usuario de la sesión activa).
polkit.addRule(function (action, subject) {
    if (!subject.local || !subject.active || !subject.isInGroup("wheel")) return;
    if (action.id == "org.freedesktop.timedate1.set-timezone" ||
        action.id == "org.freedesktop.accounts.change-own-user-data" ||
        action.id == "org.freedesktop.NetworkManager.settings.modify.system" ||
        action.id == "org.freedesktop.udisks2.filesystem-mount" ||
        action.id == "org.freedesktop.udisks2.filesystem-mount-other-seat") {
        return polkit.Result.YES;
    }
});
