  "lock": {
    "left": ["weather", "fetch", "media"],
    "right": ["stats", "notifs"],
    "showNotifContent": false,
    "city": ""
  },
  "keyboard": { "layout": "", "variant": "", "options": "grp:alt_shift_toggle" },
  "notifications": { "dnd": false },
  "ai": { "model": "" },
  "sounds": { "enabled": true, "startup": true, "volume": 0.6 },
  "ui": { "advanced": false, "style": "quantum", "page": "styles" }
