{
  "appearance": {
    "mode": "dark",
    "dynamicColors": false,
    "accent": "#6A5CFF",
    "wallpaper": "quantum:live",
    "panelOpacity": 0.86,
    "blur": true,
    "textScale": 1.0,
    "glass": { "bar": true, "dock": true, "panels": true, "windows": false },
    "windowOpacity": 0.9
  },
  "layout": {
    "style": "split",
    "topBar": { "floating": true, "showApp": true }
  },
  "dock": {
    "pinned": ["quantum-files", "firefox", "kitty", "quantum-center"],
    "floating": true,
    "align": "center",
    "size": "medium",
    "autohide": false,
    "showSearch": true,
    "showStart": true,
    "showTray": true,
    "showUpdates": true
