#!/bin/bash
# Capturas de pantalla de Quantum Linux.
#   quantum-screenshot region   elige una zona y la abre en el editor (Win + Shift + S)
#   quantum-screenshot screen   guarda la pantalla completa y la copia (Shift + Impr)
set -euo pipefail

dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Capturas"
mkdir -p "$dir"
file="$dir/Captura $(date '+%Y-%m-%d %H.%M.%S').png"

case "${1:-region}" in
    region)
        geom="$(slurp -d)" || exit 0
        qs -c quantum ipc call shell sound screenshot >/dev/null 2>&1 &
        grim -g "$geom" - | swappy -f - -o "$file"
        ;;
    screen)
        grim "$file"
        qs -c quantum ipc call shell sound screenshot >/dev/null 2>&1 &
        wl-copy < "$file"
        notify-send -a "Capturas" -i "$file" "Captura guardada" "Se copió al portapapeles y está en Imágenes/Capturas"
        ;;
    *)
        echo "Uso: quantum-screenshot region|screen" >&2
        exit 2
        ;;
esac
