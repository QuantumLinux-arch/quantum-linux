#!/bin/bash
# Instala el driver de NVIDIA (lo ejecuta pkexec, como root). Escribe «PASO n texto» para la ventana.
#   install-nvidia open   → nvidia-open-dkms y compañía, de los repos de Arch
#   install-nvidia clean  → quita el driver abierto y compañía, que chocan con los antiguos del AUR (580xx/470xx/390xx)
#   install-nvidia post   → solo lo de después (para los drivers antiguos, que se instalan desde el AUR)
set -uo pipefail
mode="${1:-}"
[[ "$mode" == open || "$mode" == post || "$mode" == clean ]] || { echo "ERROR modo inválido"; exit 2; }

if [[ "$mode" == clean ]]; then
    echo "PASO 1 Quitando el driver que no sirve para tu tarjeta"
    old=$(pacman -Qq nvidia-settings nvidia-open-dkms nvidia-open nvidia-open-lts nvidia nvidia-lts nvidia-dkms \
                     nvidia-utils lib32-nvidia-utils opencl-nvidia lib32-opencl-nvidia 2>/dev/null | grep -v -- '-[0-9]*xx')
    # -dd: el driver antiguo trae los mismos nombres (nvidia-utils…) y los reemplaza enseguida
    [[ -n "$old" ]] && { pacman -Rdd --noconfirm $old || { echo "ERROR no se pudo quitar el driver anterior"; exit 4; }; }
    exit 0
fi

# Arranque seguro: los módulos que compila DKMS se firman con la llave de este PC
D=/var/lib/quantum/secureboot
if [[ -f $D/MOK.key && -f $D/MOK.crt ]]; then
    mkdir -p /etc/dkms/framework.conf.d
    printf 'mok_signing_key=%s\nmok_certificate=%s\n' "$D/MOK.key" "$D/MOK.crt" > /etc/dkms/framework.conf.d/quantum-mok.conf
fi

if [[ "$mode" == open ]]; then
    echo "PASO 1 Descargando el driver"
    pacman -Sy --needed --noconfirm archlinux-keyring >/dev/null 2>&1
    pacman -S --needed --noconfirm linux-zen-headers nvidia-open-dkms nvidia-utils lib32-nvidia-utils nvidia-settings \
        || { echo "ERROR no se pudo instalar el driver (¿hay internet?)"; exit 3; }
fi

echo "PASO 2 Preparándolo para tu sistema"
# sin «kms» en el initramfs, para que el driver básico (nouveau) no se cargue antes que el de NVIDIA
for f in /etc/mkinitcpio.conf /etc/mkinitcpio.conf.d/*.conf; do
    [[ -f $f ]] && sed -i '/^HOOKS=/ s/ kms\b//' "$f"
done
dkms autoinstall >/dev/null 2>&1 || true

echo "PASO 3 Activándolo"
mkinitcpio -P >/dev/null 2>&1 || echo "AVISO mkinitcpio terminó con avisos"
[[ -x /usr/lib/quantum/secureboot/sign ]] && /usr/lib/quantum/secureboot/sign >/dev/null 2>&1
grub-mkconfig -o /boot/grub/grub.cfg >/dev/null 2>&1 || true
echo "PASO 4 Listo"
